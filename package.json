{
  "name": "hyra-docker-manager",
  "version": "0.1.19",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "desktop": "node scripts/desktop-dev.mjs",
    "bump-version": "node scripts/bump-version.mjs",
    "desktop:build": "node scripts/bump-version.mjs && node scripts/kill-desktop-app.mjs && next build && node scripts/prepare-desktop.mjs && electron-builder --win",
    "desktop:pack": "node scripts/kill-desktop-app.mjs && next build && node scripts/prepare-desktop.mjs && electron-builder --win --dir"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@vercel/analytics": "1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mysql2": "^3.22.5",
    "next": "16.2.6",
    "ppk-to-openssh": "^3.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ssh2": "^1.15.5",
    "concurrently": "^9.2.1",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.tiresia.hyra-docker-manager",
    "productName": "Hyra Docker Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "!.next/**/*",
      "!components/**/*",
      "!lib/**/*",
      "!app/**/*",
      "!public/**/*",
      "!release/**/*"
    ],
    "afterPack": "scripts/electron-after-pack.cjs",
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*",
          "!release/**",
          "!release-build/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "npmRebuild": false,
    "asar": false,
    "asarUnpack": [
      "**/node_modules/ssh2/**",
      "**/node_modules/cpu-features/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
